# Copy this file to .env and fill in as needed. All of these have working
# defaults for local dev except TESSERACT_CMD, which you only need on Windows
# (or anywhere Tesseract isn't automatically on PATH).

# Swap for a Postgres/Supabase connection string in production.
DATABASE_URL=sqlite:///./skilldna.db

# Used to sign JWT login sessions. The app runs without this (falls back to a
# dev-only placeholder) but you MUST set a long random value before deploying
# anywhere real -- e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# Optional. Raises the GitHub API rate limit from 60/hr to 5000/hr. Create a
# free personal access token at https://github.com/settings/tokens (no scopes
# needed for public data).
GITHUB_TOKEN=

# Comma-separated list of allowed frontend origins, e.g.
# https://skilldna.vercel.app,http://localhost:5173
# Defaults to "*" (allow any origin) if unset -- fine for local dev, but set
# this to your real frontend URL(s) before deploying anywhere public.
CORS_ORIGINS=

# Only needed if `tesseract` isn't on your system PATH -- this is the common
# case on Windows even after installing it. Point this at the full path to
# the tesseract executable. Leave blank on Linux/Mac if `tesseract --version`
# already works in your terminal.
#   Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   Mac (Homebrew) example: TESSERACT_CMD=/opt/homebrew/bin/tesseract
TESSERACT_CMD=
